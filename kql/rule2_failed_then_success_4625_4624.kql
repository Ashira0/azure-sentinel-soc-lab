// Candidate correlation: >=3 failures in a 10-minute bin, followed by success
// within 15 minutes of the last failure for the same account and source IP.
// Bin boundaries may split bursts; review before production deployment.
let Failures = Event
| where TimeGenerated >= ago(2h)
| where EventLog == "Security" and EventID == 4625
| extend Account = tolower(extract(@'<Data Name="TargetUserName">([^<]*)</Data>', 1, tostring(EventData))),
         IpAddress = extract(@'<Data Name="IpAddress">([^<]*)</Data>', 1, tostring(EventData))
| where isnotempty(Account) and isnotempty(IpAddress) and IpAddress != "-"
| summarize Fails=count(), FirstFail=min(TimeGenerated), LastFail=max(TimeGenerated)
    by Account, IpAddress, FailureWindow=bin(TimeGenerated, 10m)
| where Fails >= 3;
let Successes = Event
| where TimeGenerated >= ago(2h)
| where EventLog == "Security" and EventID == 4624
| extend Account = tolower(extract(@'<Data Name="TargetUserName">([^<]*)</Data>', 1, tostring(EventData))),
         IpAddress = extract(@'<Data Name="IpAddress">([^<]*)</Data>', 1, tostring(EventData))
| where isnotempty(Account) and isnotempty(IpAddress) and IpAddress != "-"
| project Account, IpAddress, SuccessTime=TimeGenerated, SuccessComputer=Computer;
Failures
| join kind=inner Successes on Account, IpAddress
| where SuccessTime > LastFail and SuccessTime <= LastFail + 15m
| project SuccessTime, Account, IpAddress, Fails, FirstFail, LastFail, FailureWindow, SuccessComputer
| order by SuccessTime desc
